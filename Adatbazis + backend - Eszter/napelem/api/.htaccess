# A létező fájlok (a régi végpontok és az Attila által később betett php-k) önállóan futnak.
# Ami nincs a lemezen (pl. /alkatreszek), az az index.php-ra kerül. A basePath nem tartalmaz hosztnevet.
AcceptPathInfo On
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>
