{
  "name": "napelem/backend",
  "description": "Napelemrendszer raktár- és projektkezelő API (Slim 4)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14"
  },
  "autoload": {
    "psr-4": {
      "Napelem\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
